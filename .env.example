# 관리자 이름은 admin입니다. 감상 화면과 관리 화면 모두 이 계정으로 로그인합니다.
# 비워 두면 화면/API가 비활성화되니 서버에서는 반드시 긴 비밀번호를 넣어 주세요.
ADMIN_PASSWORD=
# Docker 포트 공개 범위. 기본 127.0.0.1(서버 내부/리버스 프록시용). 외부에서 바로 접속하려면 0.0.0.0
GUKAWA_BIND=127.0.0.1
GUKAWA_PORT=8000
# 로컬 미리보기: 이 PC에서 목록·영상·자막을 로그인 없이 봅니다. 관리 작업은 인증을 유지합니다.
LOCAL_PREVIEW=false
DATA_DIR=./data
INSTAGRAM_USERNAME=chiikawa.anime
# 360화부터 수집합니다. 회차 번호를 확인할 수 없는 게시물은 제외합니다.
MIN_EPISODE=360
# Netscape 형식 쿠키 파일. 로컬에서 사용할 때의 경로입니다.
INSTAGRAM_COOKIES=./secrets/instagram-cookies.txt
AUTO_SYNC=true
SYNC_INTERVAL_SECONDS=3600
DISCOVERY_LIMIT=12
MAX_ATTEMPTS=3
# source: 영상·원문만 저장 / translate: 일본어·영어 원문을 추출해 자동 번역까지 실행
PROCESSING_MODE=translate
INITIAL_BACKFILL=true
# 확인한 720×1280 또는 1080×1920 영상에서 본편 재생용 파일을 만듭니다.
CREATE_PLAYBACK=true

# OpenAI Responses API. 키는 브라우저에 전달되지 않습니다.
OPENAI_API_KEY=
TRANSLATION_MODEL=gpt-6.1-terra
# true: 번역 완료 후 자동 공개 / false: 관리자 검토 후 공개
AUTO_PUBLISH=true

# 화면의 아래쪽 45%에서 영어 자막을 찾습니다. 실제 영상에 맞게 조절하세요.
OCR_CROP_TOP=0.55
OCR_CROP_BOTTOM=1.0
OCR_SAMPLE_FPS=4
OCR_MIN_CONFIDENCE=0.75
MAX_VIDEO_SECONDS=600
MAX_VIDEO_BYTES=524288000
